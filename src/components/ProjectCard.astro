---
import TagList from "./TagList.astro";

interface Props {
  title: string;
  description: string;
  tech: string[];
  link?: string;
  prompt?: string;
  image?: string;
  imageAlt?: string;
  video?: string;
  videoAlt?: string;
}

const { title, description, tech, link, prompt, image, imageAlt, video, videoAlt } = Astro.props;
const withBase = (path: string) => import.meta.env.BASE_URL + path.replace(/^\//, "");
---

<article class="card">
  {
    image && (
      <img
        class="card__thumb"
        src={image.startsWith("http") ? image : withBase(image)}
        alt={imageAlt ?? `${title} diagram`}
        loading="lazy"
      />
    )
  }
  {
    video && (
      <video
        class="card__thumb"
        src={video.startsWith("http") ? video : withBase(video)}
        controls
        muted
        loop
        playsinline
        aria-label={videoAlt ?? `${title} preview`}
      />
    )
  }
  <h3>
    <a href={link} target="_blank" rel="noopener noreferrer">
      {title}
    </a>
  </h3>
  <TagList tags={tech} />
  <p class="project-description">{description}</p>
  <div class="card__links">
    <a href={link} target="_blank" rel="noopener noreferrer">
      {prompt}
    </a>
  </div>
</article>
