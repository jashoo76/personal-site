---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const sorted = projects.sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout title="Projects" description="Embedded systems and firmware projects.">
  <div class="container page-header">
    <h1>Projects</h1>
    <p>
      Some of the projects I've worked on over the past few years — I can't share everything due to NDAs, but I hope you find these interesting.
    </p>
  </div>
  <div class="container card-grid">
    {sorted.map((project) => (
      <ProjectCard {...project.data} />
    ))}
  </div>
</BaseLayout>
